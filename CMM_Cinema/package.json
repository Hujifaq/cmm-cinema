{
  "name": "cmm_cinema",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "vendor:sync": "node scripts/sync-swiper.cjs",
    "postinstall": "npm run vendor:sync",
    "test": "node --test tests/*.test.cjs",
    "css:build": "tailwindcss -i ./Styles/tailwind.css -o ./wwwroot/css/styles.css --minify",
    "css:watch": "tailwindcss -i ./Styles/tailwind.css -o ./wwwroot/css/styles.css --watch",
    "search:build": "esbuild Client/cinema-search.tsx --bundle --minify --format=iife --target=es2020 --outfile=wwwroot/js/cinema-search.bundle.js",
    "typecheck": "tsc --noEmit",
    "now-showing:build": "esbuild Client/now-showing-title.tsx --bundle --minify --format=iife --target=es2020 --define:window.gsap=undefined --outfile=wwwroot/js/now-showing-title.bundle.js",
    "build": "npm run typecheck && npm run search:build && npm run now-showing:build && npm run css:build",
    "pretest": "npm run search:build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.2.0",
    "gsap": "3.15.0",
    "heroicons": "^2.2.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.57.0",
    "morphicons": "^1.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0"
  }
}
