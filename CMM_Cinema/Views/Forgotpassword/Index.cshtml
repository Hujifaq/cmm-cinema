@model ForgotPasswordViewModel
@{
    Layout = "_HeroLayout";
    ViewData["Title"] = "Forgot password - CMM Cinema";
    var hasEmailError = ViewData.ModelState[nameof(Model.Email)]?.Errors.Count > 0;
}

@section TopBanner {
    @await Html.PartialAsync("_CinemaMarquee")
}

<section class="flex min-h-[calc(100svh_-_36px)] items-center justify-center bg-cinema-paper px-5 pb-14 pt-28 font-sans text-cinema-ink scheme-light md:pb-20 md:pt-36" aria-labelledby="reset-title" data-forgot-password-page>
    @await Html.PartialAsync("_GooFilter")
    <div class="w-full max-w-[480px] rounded-[28px] bg-cinema-paper p-6 shadow-clay ring-1 ring-cinema-ink/10 sm:p-10" data-reset-card>
        <header class="mb-8 text-center">
            <h1 class="m-0 text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl" id="reset-title" data-reveal-chars>Forgot your password?</h1>
            <p class="mb-0 mt-3 text-sm leading-relaxed text-cinema-ink/60" data-reveal-up>Let's get you back to your next movie night.</p>
        </header>

        <form class="grid gap-5" asp-controller="Forgotpassword" asp-action="Index" method="post">
            <div data-reveal-up>
                <label class="mb-2 block text-sm font-bold text-cinema-ink" for="reset-email">Email address</label>
                <div class="relative">
                    <svg class="pointer-events-none absolute left-4 top-1/2 size-4 -translate-y-1/2 text-cinema-ink/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    <input class="block min-h-[48px] w-full min-w-0 rounded-2xl border-0 bg-white py-3 pl-11 pr-4 font-sans text-base text-cinema-ink shadow-sm placeholder:text-cinema-ink/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-ink aria-invalid:ring-2 aria-invalid:ring-cinema-brick/30" asp-for="Email" id="reset-email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" maxlength="254" aria-describedby="reset-email-error" aria-invalid="@hasEmailError.ToString().ToLowerInvariant()" required />
                </div>
                <span class="mt-2 block text-xs leading-relaxed text-cinema-brick" id="reset-email-error" asp-validation-for="Email"></span>
            </div>

            <div data-reveal-up>
                <button class="group relative isolate inline-flex min-h-[44px] w-full cursor-pointer items-center justify-center rounded-xl border-0 bg-cinema-ink px-6 py-3 font-sans text-sm font-bold text-cinema-cream shadow-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-ink" type="submit" data-goo-button>
                    <span class="pointer-events-none absolute inset-0 -z-1 [filter:url(#goo-filter)]" aria-hidden="true">
                        <span class="absolute inset-0 rounded-xl bg-cinema-ink"></span>
                        <span class="absolute inset-0 overflow-hidden rounded-xl"><span class="absolute left-0 top-0 aspect-square w-[250%] rounded-full bg-cinema-ink" data-goo-fill></span></span>
                        <span class="absolute left-0 top-0 size-9 rounded-full bg-cinema-ink" data-goo-blob></span>
                    </span>
                    <span class="relative" data-goo-label>Send reset link</span>
                </button>
            </div>

            @if (ViewData["ResetUnavailable"] is true)
            {
                <p class="m-0 rounded-2xl bg-cinema-ink/[0.04] px-4 py-3 text-center text-sm leading-relaxed text-cinema-ink/70" role="status">Password reset is not available yet. Please check back soon.</p>
            }
        </form>

        <div class="mt-3 text-center" data-reveal-up>
            <a class="inline-flex min-h-[44px] items-center justify-center gap-2 text-sm font-bold text-cinema-ink underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-ink" asp-controller="LoginRegister" asp-action="Index">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 12H4m6-6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Back to login
            </a>
        </div>
    </div>
</section>

@await Html.PartialAsync("_AccountFooter")
