@model MovieSectionViewModel
@{
    var sectionClass = Model.Overlap
        ? "-mt-12 rounded-t-[40px] pb-16 pt-12 md:-mt-16 md:rounded-t-[56px] md:pb-24 md:pt-20"
        : "pb-16 md:pb-24";
}

<section class="relative z-20 overflow-hidden bg-cinema-paper font-sans text-cinema-ink @sectionClass" aria-labelledby="@Model.Id-title">
    <div class="mx-auto max-w-[1440px] px-5 md:px-12">
        <div class="flex items-end justify-between gap-4">
            <h2 class="m-0 text-5xl font-black uppercase leading-none tracking-tighter sm:text-7xl md:text-8xl lg:text-[8rem]" id="@Model.Id-title">
                <span data-section-title>@Model.Title</span>
            </h2>
            <a class="shrink-0 border-b-2 border-cinema-ink pb-0.5 text-sm font-bold text-cinema-ink no-underline" href="#">View all</a>
        </div>

        <div class="swiper movie-swiper mt-8 md:mt-12" data-movie-swiper>
            <div class="swiper-wrapper">
                @foreach (var movie in Model.Movies)
                {
                    <div class="swiper-slide h-auto">
                        @await Html.PartialAsync("_MovieCard", movie)
                    </div>
                }
            </div>
        </div>
    </div>
</section>
