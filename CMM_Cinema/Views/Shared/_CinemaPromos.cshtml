@model IReadOnlyList<Promotion>
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@{ Context.RequireAssets("promos"); }
@{
    var isAdmin = User.IsInRole(AuthClaims.AdminRole);
    var manageClass = "inline-flex min-h-11 items-center justify-center rounded-full bg-cinema-cream px-5 text-sm font-bold text-cinema-ink no-underline transition-colors duration-300 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-cream motion-reduce:transition-none";
    var arrowClass = "promo-arrow relative inline-flex size-12 shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0 text-cinema-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-cream disabled:cursor-default disabled:opacity-30 md:size-14";
}

@if (Model.Count == 0)
{
    @if (isAdmin)
    {
        <section id="cinema-promotions" class="relative z-10 bg-black px-5 py-10 font-sans text-cinema-cream md:px-12" aria-label="Cinema promotions">
            <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-4">
                <p class="m-0 text-sm text-cinema-cream/70">No promotion banners are showing on the home page.</p>
                <a class="@manageClass" href="/Admin/Promotions">Manage promotions</a>
            </div>
        </section>
    }
}
else
{
<section id="cinema-promotions" class="cinema-promos relative z-10 overflow-hidden bg-black pb-14 pt-6 font-sans text-cinema-cream md:py-24" aria-label="Cinema promotions" data-promo-section>
    <div class="promo-ribbon" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Cinema promotions. Swipe, drag or use the arrow keys to browse." data-promo-ribbon>
        <ol class="carousel-track" data-track>
            @for (var i = 0; i < Model.Count; i++)
            {
                var promotion = Model[i];
                var source = promotion.IsLocal ? FileVersions.AddFileVersionToPath(Context.Request.PathBase, promotion.ImageUrl) : Context.Request.PathBase + promotion.ProxyUrl;
                <li class="card" data-card data-ratio="1672/941" data-seed="@i" role="group" aria-roledescription="promotion" aria-labelledby="promo-title-@i">
                    <div class="card-media">
                        <img src="@source" width="1400" height="788" alt="@promotion.Alt" decoding="async" draggable="false" />
                    </div>
                    <div class="sr-only">
                        <h3 id="promo-title-@i">@promotion.Alt</h3>
                    </div>
                </li>
            }
        </ol>
    </div>

    <div class="mx-auto max-w-[1440px] px-5 md:px-12">
        <div class="promo-controls mt-6 flex items-center @(isAdmin ? "justify-between" : "justify-end") gap-5 md:mt-8">
            @if (isAdmin)
            {
                <a class="@manageClass" href="/Admin/Promotions">Manage promotions</a>
            }
            <div class="flex shrink-0 gap-4 md:gap-6">
                <button class="@arrowClass" type="button" aria-label="Previous promotion" data-promo-prev data-magnetic-arrow>@await Html.PartialAsync("_PromoArrowSurface", false)</button>
                <button class="@arrowClass" type="button" aria-label="Next promotion" data-promo-next data-magnetic-arrow>@await Html.PartialAsync("_PromoArrowSurface", true)</button>
            </div>
        </div>
    </div>
</section>
}
