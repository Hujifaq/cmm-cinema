<!DOCTYPE html>
<html lang="en" class="bg-white">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>@ViewData["Title"] - CMM Cinema</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cinema-nav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/booking/booking.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="booking-page">
    @if (IsSectionDefined("TopBanner"))
    {
        @await RenderSectionAsync("TopBanner", required: false)
    }
    else
    {
        <div class="booking-banner cinema-marquee" data-marquee aria-label="Cinema promotions">
            <div class="cinema-marquee__track" data-marquee-track>
                @for (var copy = 0; copy < 2; copy++)
                {
                    <div class="cinema-marquee__group" aria-hidden="@(copy == 1 ? "true" : "false")">
                        <span>Movie night, made better — tickets from ฿150</span><span aria-hidden="true">✦</span>
                        <span>Double the fun — buy 1 ticket, get 1 free on Wednesdays</span><span aria-hidden="true">✦</span>
                        <span>Student perks — save 20% on your next screening</span><span aria-hidden="true">✦</span>
                    </div>
                }
            </div>
        </div>
    }
    @await Html.PartialAsync("_CinemaNav")
    <main class="booking-main" id="booking-main">@RenderBody()</main>
    <footer class="booking-footer">CMM CINEMA <span>A little movie magic.</span></footer>
    <div id="cinema-search-root"></div>
    <script src="~/lib/gsap/gsap.min.js" asp-append-version="true" defer></script>
    <script src="~/js/gooey-nav.js" asp-append-version="true" defer></script>
    <script src="~/js/cinema-nav.js" asp-append-version="true" defer></script>
    <script src="~/js/cinema-nav-actions.js" asp-append-version="true" defer></script>
    <script src="~/js/cinema-search.bundle.js" asp-append-version="true" defer></script>
    <script src="~/js/cinema-marquee.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
