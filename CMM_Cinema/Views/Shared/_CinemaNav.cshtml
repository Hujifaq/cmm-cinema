@{

    var items = new[] { "Home", "Movies", "About", "Tickets" };
    var hrefs = new[] { "/", "/Movies", "/About", "/MyTickets" };
    var currentPath = (Context.Request.Path.Value ?? "").TrimEnd('/');
    var active = Math.Max(0, Array.FindIndex(hrefs, href => string.Equals(href.TrimEnd('/'), currentPath, StringComparison.OrdinalIgnoreCase) || (href != "/" && currentPath.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase))));
    var pillClass = "inline-flex min-h-11 cursor-pointer items-center justify-center whitespace-nowrap rounded-full border-0 bg-transparent px-3 py-3 font-sans text-sm font-medium leading-none transition-colors duration-200 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-cream lg:px-5";
}

<header class="pointer-events-none sticky top-0 z-40 mx-auto h-0 w-[calc(100%_-_24px)] max-w-6xl md:w-[calc(100%_-_48px)]" data-nav-header>
    <nav class="pointer-events-auto relative top-[max(12px,env(safe-area-inset-top))] min-w-0 overflow-clip rounded-[32px] bg-black/55 font-sans shadow-[0_8px_32px_#0003,inset_0_1px_0_#ffffff14] ring-1 ring-inset ring-white/15 backdrop-blur-xl backdrop-saturate-150 md:top-6 md:rounded-full" aria-label="Main navigation" tabindex="-1" data-cinema-nav>
        <div class="relative z-10 flex min-h-16 min-w-0 flex-wrap items-center justify-between gap-2 p-2.5 pl-5 md:grid md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:gap-3 md:px-6 md:py-3" data-nav-top>
            <a class="flex shrink-0 items-center rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-cream" href="/" aria-label="CMM Cinema home" data-nav-logo>
                <img class="block h-auto w-[104px] select-none md:w-32" src="~/images/CMM_Logo_Colored.png" asp-append-version="true" width="1938" height="811" alt="CMM Cinema" draggable="false" />
            </a>
            <div class="min-w-0 max-w-full md:justify-self-center" data-desktop-nav>
                <div class="relative max-w-full" data-gooey-nav>
                    <canvas class="pointer-events-none absolute left-0 top-0" aria-hidden="true"></canvas>
                    <span class="pointer-events-none absolute left-0 top-0 hidden rounded-full bg-cinema-cream" data-gooey-fallback aria-hidden="true"></span>
                    <ul class="relative m-0 flex list-none flex-wrap gap-1 p-0 text-white/65 md:flex-nowrap lg:gap-1.5" data-gooey-list>
                        @for (var i = 0; i < items.Length; i++)
                        {
                            <li class="flex" style="--nav-item: @i" data-gooey-index="@i"><button class="@pillClass" type="button" data-href="@hrefs[i]" aria-pressed="@(i == active ? "true" : "false")">@items[i]</button></li>
                        }
                    </ul>
                    <ul class="pointer-events-none invisible absolute inset-0 m-0 flex list-none flex-wrap gap-1 p-0 text-black md:flex-nowrap lg:gap-1.5" style="clip-path: inset(100%)" data-gooey-overlay aria-hidden="true">
                        @for (var i = 0; i < items.Length; i++)
                        {
                            <li class="flex" style="--nav-item: @i"><span class="@pillClass">@items[i]</span></li>
                        }
                    </ul>
                </div>
            </div>
            @* Account destinations can be connected when authentication is ready. *@
            <div class="relative flex shrink-0 items-center gap-0 md:justify-self-end md:gap-1 lg:gap-2" data-nav-actions>
                <span class="pointer-events-none absolute left-0 top-0 rounded-full opacity-0" aria-hidden="true" data-nav-action-pill></span>
                <button class="relative z-10 inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0 text-cinema-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-cream" type="button" aria-label="Search" aria-expanded="false" aria-controls="cinema-search" data-nav-search data-nav-action>
                    @await Html.PartialAsync("_SearchIcon")
                </button>
                <button class="relative z-10 hidden min-h-11 cursor-pointer items-center justify-center whitespace-nowrap rounded-full border-0 bg-transparent px-2 text-sm font-medium text-cinema-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-cream md:inline-flex lg:px-3" type="button" data-nav-account data-nav-action>Login / Register</button>
                <button class="group relative hidden min-h-11 min-w-14 shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent px-3 text-sm font-medium text-white transition-colors hover:text-cinema-cyan aria-expanded:text-cinema-cyan focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-cyan" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="cinema-mobile-menu" data-nav-toggle>
                    <span class="pointer-events-none block h-5 overflow-hidden leading-5" aria-hidden="true">
                        <span class="block transition-transform duration-300 ease-out group-aria-expanded:-translate-y-1/2 motion-reduce:transition-none">
                            <span class="block">Menu</span>
                            <span class="block">Close</span>
                        </span>
                    </span>
                </button>
            </div>
        </div>

        <div class="absolute -right-3 top-[calc(0px_-_var(--nav-viewport-top,max(12px,env(safe-area-inset-top))))] h-dvh w-[min(420px,100vw)] overflow-hidden rounded-l-[32px] md:hidden" id="cinema-mobile-menu" data-mobile-menu hidden inert>
            <div class="pointer-events-none absolute inset-0 origin-right rounded-l-[32px] bg-cinema-cyan" data-menu-layer aria-hidden="true"></div>
            <div class="pointer-events-none absolute inset-0 origin-right rounded-l-[32px] bg-[#616a6c]" data-menu-layer aria-hidden="true"></div>
            <div class="relative flex h-full origin-right flex-col overflow-y-auto overscroll-contain rounded-l-[32px] bg-[#121617] px-5 pb-[max(24px,env(safe-area-inset-bottom))] pt-[calc(var(--nav-viewport-top,max(12px,env(safe-area-inset-top)))_+_88px)] ring-1 ring-inset ring-white/10 sm:px-7" data-mobile-menu-content>
                <ul class="m-0 flex list-none flex-col gap-2 p-0">
                    @for (var i = 0; i < items.Length; i++)
                    {
                        <li>
                            <button class="block min-h-15 w-full cursor-pointer rounded-2xl border-0 bg-transparent px-3 py-3 text-left font-sans text-[clamp(2rem,8vw,3.5rem)] font-medium leading-[1.1] tracking-[-0.04em] text-white/80 transition-colors hover:text-cinema-cyan focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-cinema-cyan" type="button" aria-pressed="@(i == active ? "true" : "false")" data-mobile-index="@i">
                                <span class="block overflow-hidden">
                                    <span class="block origin-bottom-left break-words" data-menu-label>@items[i]</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
                <button class="mt-8 inline-flex min-h-12 w-full shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-cinema-cream px-5 py-3 font-sans text-sm font-semibold text-cinema-ink transition-colors duration-150 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-cyan" type="button" data-nav-account>Login / Register</button>
            </div>
        </div>
    </nav>
</header>
