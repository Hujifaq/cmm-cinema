@model string
@{
    var front = Model == "front";
    var id = front ? "auth-clay-front" : "auth-clay-rear";
    var curve = front
        ? "M352 338C292 390 173 405 94 350C61 292 90 232 83 245"
        : "M465 65C350 -15 100 10 60 200C35 280 110 300 145 240C190 145 321 178 352 275C376 300 376 324 352 338";
}

@* Two sections share the mascot's coordinates: one behind Poppy, one over its lower edge. *@
<svg class="auth-clay-tube" viewBox="0 0 440 420" fill="none" aria-hidden="true" focusable="false" data-auth-clay="@Model" data-auth-clay-mask="@(id + "-reveal")">
    <defs>
        <path id="@(id + "-curve")" d="@curve" />
        <linearGradient id="@(id + "-color")" x1="50" y1="30" x2="380" y2="410" gradientUnits="userSpaceOnUse">
            <stop stop-color="var(--color-cinema-clay-blush, #ffd1e3)" />
            <stop offset="0.4" stop-color="var(--color-cinema-clay-pink, #ee91bd)" />
            <stop offset="0.75" stop-color="var(--color-cinema-clay-blush, #ffd1e3)" />
            <stop offset="1" stop-color="var(--color-cinema-clay-rose, #b85b8c)" />
        </linearGradient>
        <filter id="@(id + "-clay")" x="-15%" y="-20%" width="130%" height="145%" color-interpolation-filters="sRGB">
            @* Opposing soft inner rims round the tube without flattening its color. *@
            <feOffset in="SourceAlpha" dx="7" dy="10" result="top-offset" />
            <feGaussianBlur in="top-offset" stdDeviation="7" result="top-soft" />
            <feComposite in="SourceAlpha" in2="top-soft" operator="out" result="top-rim" />
            <feFlood flood-color="white" flood-opacity="0.55" result="rim-light" />
            <feComposite in="rim-light" in2="top-rim" operator="in" result="highlight" />
            <feOffset in="SourceAlpha" dx="-8" dy="-10" result="bottom-offset" />
            <feGaussianBlur in="bottom-offset" stdDeviation="8" result="bottom-soft" />
            <feComposite in="SourceAlpha" in2="bottom-soft" operator="out" result="bottom-rim" />
            <feFlood flood-color="var(--color-cinema-clay-rose, #b85b8c)" flood-opacity="0.65" result="rim-dark" />
            <feComposite in="rim-dark" in2="bottom-rim" operator="in" result="shade" />
            <feMerge>
                <feMergeNode in="SourceGraphic" />
                <feMergeNode in="shade" />
                <feMergeNode in="highlight" />
            </feMerge>
        </filter>
        <filter id="@(id + "-shadow")" x="-30%" y="-30%" width="160%" height="170%">
            <feGaussianBlur stdDeviation="7" />
        </filter>
        <mask id="@(id + "-reveal")" maskUnits="userSpaceOnUse" x="-80" y="-80" width="640" height="600" style="mask-type: alpha">
            <path d="@curve" pathLength="1000" stroke="white" stroke-width="144" stroke-linecap="round" stroke-linejoin="round" data-auth-clay-trace />
        </mask>
    </defs>
    <g class="auth-clay-tube__depth" data-auth-clay-parallax>
        @* Unmasked by default: missing JS and reduced motion show the finished tube. *@
        <g data-auth-clay-drawing>
            <use href="#@(id + "-curve")" transform="translate(3 10)" stroke="var(--color-cinema-ink)" stroke-opacity="0.4" stroke-width="80" stroke-linecap="round" stroke-linejoin="round" filter="url(#@(id + "-shadow"))" />
            <use href="#@(id + "-curve")" stroke="url(#@(id + "-color"))" stroke-width="76" stroke-linecap="round" stroke-linejoin="round" filter="url(#@(id + "-clay"))" />
        </g>
    </g>
</svg>
