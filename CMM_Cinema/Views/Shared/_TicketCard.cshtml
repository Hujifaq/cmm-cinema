@model Ticket
@{
    // Half-circle cut-outs where the stub tears off: left/right edges on phones, top/bottom of the divider from md up.
    // Each sits inside the card, so nothing paints over the clay shadow outside; its inner shadow reads as a pressed-in hole.
    var notchClass = "pointer-events-none absolute bg-cinema-paper shadow-[inset_0_0_6px_rgb(7_28_30/0.14)]";
}

<article class="group/ticket relative grid grid-cols-1 rounded-[32px] bg-white shadow-clay transition-[translate,box-shadow] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1.5 hover:shadow-clay-hover motion-reduce:transition-none motion-reduce:hover:translate-y-0 md:grid-cols-[minmax(0,1fr)_240px] lg:grid-cols-[minmax(0,1fr)_280px]" aria-labelledby="ticket-@Model.BookingCode" data-ticket-card>
    <div class="min-w-0 p-4 sm:p-6 md:p-7">
        @await Html.PartialAsync("_TicketSummary", Model)
    </div>

    <div class="relative flex items-center justify-between gap-4 rounded-b-[32px] border-0 border-t-2 border-dashed border-cinema-ink/20 p-4 sm:p-6 md:flex-col md:items-stretch md:justify-center md:gap-5 md:rounded-bl-none md:rounded-r-[32px] md:border-l-2 md:border-t-0 md:p-7 bg-linear-to-br from-white to-cinema-linen shadow-clay-stub">
        <span class="@notchClass left-0 -top-3.75 h-7 w-3.5 rounded-r-full md:-left-3.75 md:top-0 md:h-3.5 md:w-7 md:rounded-r-none md:rounded-b-full" aria-hidden="true"></span>
        <span class="@notchClass right-0 -top-3.75 h-7 w-3.5 rounded-l-full md:hidden" aria-hidden="true"></span>
        <span class="@notchClass bottom-0 -left-3.75 hidden h-3.5 w-7 rounded-t-full md:block" aria-hidden="true"></span>

        <div class="min-w-0" data-ticket-stub>
            <p class="m-0 text-[10px] font-bold uppercase tracking-widest text-cinema-ink/60">@(Model.Seats.Count == 1 ? "Seat" : "Seats")</p>
            <p class="m-0 mt-1 text-2xl font-black uppercase leading-none tracking-tighter md:text-3xl">@string.Join(", ", Model.Seats)</p>
            @if (Model.IsPast)
            {
                <span class="mt-3 inline-block rounded-full border border-cinema-ink/40 px-3 py-1.5 text-[11px] font-semibold leading-none text-cinema-ink/70">Watched</span>
            }
            else
            {
                <span class="mt-3 inline-block rounded-full bg-cinema-logo px-3 py-1.5 shadow-clay-pill text-[11px] font-bold leading-none text-white">Confirmed</span>
            }
        </div>
        @await Html.PartialAsync("_GooButton", (Label: "View ticket", Href: Model.Url, Accent: Model.IsPast ? "bg-cinema-sky" : "bg-cinema-cyan"), new ViewDataDictionary(ViewData) { ["GooClass"] = "shrink-0 px-6 font-sans", ["GooLabel"] = $"View ticket for {Model.Movie.Title}" })
    </div>
</article>
