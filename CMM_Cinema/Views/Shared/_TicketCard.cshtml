@model Ticket
@{
    // Half-circle cut-outs where the stub tears off: left/right edges on phones, top/bottom of the divider from md up.
    var notchClass = "pointer-events-none absolute size-7 rounded-full border border-cinema-ink/15 bg-cinema-paper";
}

<article class="group/ticket relative grid grid-cols-1 overflow-hidden rounded-[28px] border border-cinema-ink/15 bg-white shadow-[0_18px_40px_-28px_rgb(7_28_30/0.45)] transition-[translate,box-shadow,border-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:border-cinema-ink/30 hover:shadow-[0_28px_50px_-26px_rgb(7_28_30/0.55)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 md:grid-cols-[minmax(0,1fr)_240px] lg:grid-cols-[minmax(0,1fr)_280px]" aria-labelledby="ticket-@Model.BookingCode" data-ticket-card>
    <div class="min-w-0 p-4 sm:p-6 md:p-7">
        @await Html.PartialAsync("_TicketSummary", Model)
    </div>

    <div class="relative flex items-center justify-between gap-4 border-t-2 border-dashed border-cinema-ink/20 p-4 sm:p-6 md:flex-col md:items-stretch md:justify-center md:gap-5 md:border-l-2 md:border-t-0 md:p-7 @(Model.IsPast ? "bg-cinema-ink/[0.03]" : "bg-cinema-cream")">
        <span class="@notchClass -left-3.75 -top-3.75" aria-hidden="true"></span>
        <span class="@notchClass -right-3.75 -top-3.75 md:hidden" aria-hidden="true"></span>
        <span class="@notchClass -bottom-3.75 -left-3.75 hidden md:block" aria-hidden="true"></span>

        <div class="min-w-0" data-ticket-stub>
            <p class="m-0 text-[10px] font-bold uppercase tracking-widest text-cinema-ink/60">@(Model.Seats.Count == 1 ? "Seat" : "Seats")</p>
            <p class="m-0 mt-1 text-2xl font-black uppercase leading-none tracking-tighter md:text-3xl">@string.Join(", ", Model.Seats)</p>
            @if (Model.IsPast)
            {
                <span class="mt-3 inline-block rounded-full border border-cinema-ink/40 px-3 py-1.5 text-[11px] font-semibold leading-none text-cinema-ink/70">Watched</span>
            }
            else
            {
                <span class="mt-3 inline-block rounded-full bg-cinema-sun px-3 py-1.5 text-[11px] font-bold leading-none text-cinema-ink">Confirmed</span>
            }
        </div>
        @await Html.PartialAsync("_GooButton", (Label: "View ticket", Href: Model.Url, Accent: Model.IsPast ? "bg-cinema-sky" : "bg-cinema-sun"), new ViewDataDictionary(ViewData) { ["GooClass"] = "shrink-0 px-6 font-sans", ["GooLabel"] = $"View ticket for {Model.Movie.Title}" })
    </div>
</article>
