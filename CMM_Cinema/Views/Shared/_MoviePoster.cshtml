@model Movie
@{
    // Drawn posters for movies without a poster_url. Classes live here so Tailwind can see them.
    var themes = new Dictionary<string, (string Bg, string Text, string Badge, string Art)>
    {
        ["ink-orbit"] = ("bg-cinema-ink", "text-cinema-cream", "border-cinema-cream text-cinema-cream", "absolute -right-12 top-4 size-[80%] rounded-full bg-cinema-sky"),
        ["sky-arch"] = ("bg-cinema-sky", "text-cinema-ink", "border-cinema-ink text-cinema-ink", "absolute left-[14%] top-[12%] h-[56%] w-[72%] rounded-t-full bg-cinema-ink"),
        ["sun-eclipse"] = ("bg-cinema-sun", "text-cinema-ink", "border-cinema-sun bg-cinema-sun text-cinema-ink", "absolute -top-[40%] -inset-x-[10%] h-[75%] rounded-full bg-cinema-ink"),
        ["brick-stripes"] = ("bg-cinema-brick", "text-cinema-cream", "border-cinema-cream text-cinema-cream", "absolute inset-x-0 top-0 h-[56%] bg-[repeating-linear-gradient(120deg,var(--color-cinema-cream)_0_14px,transparent_14px_32px)]"),
        ["brick-orbit"] = ("bg-cinema-brick", "text-cinema-cream", "border-cinema-cream text-cinema-cream", "absolute -right-12 top-4 size-[80%] rounded-full bg-cinema-sun"),
        ["sun-arch"] = ("bg-cinema-sun", "text-cinema-ink", "border-cinema-ink text-cinema-ink", "absolute left-[14%] top-[12%] h-[56%] w-[72%] rounded-t-full bg-cinema-brick"),
        ["ink-eclipse"] = ("bg-cinema-ink", "text-cinema-cream", "border-cinema-cream text-cinema-cream", "absolute -top-[40%] -inset-x-[10%] h-[75%] rounded-full bg-cinema-sky"),
        ["sky-stripes"] = ("bg-cinema-sky", "text-cinema-ink", "border-cinema-ink text-cinema-ink", "absolute inset-x-0 top-0 h-[56%] bg-[repeating-linear-gradient(120deg,var(--color-cinema-ink)_0_14px,transparent_14px_32px)]"),
    };
    var theme = themes.GetValueOrDefault(Model.PosterTheme, themes["ink-orbit"]);
}

<div class="relative size-full @theme.Bg @ViewData["PosterClass"]">
    @if (!string.IsNullOrEmpty(Model.PosterUrl))
    {
        <img class="absolute inset-0 size-full object-cover" src="@Model.PosterUrl" alt="" loading="lazy" draggable="false" />
        <span class="absolute left-3 top-3 rounded-full border border-white/60 bg-black/40 px-2 py-0.5 text-[10px] font-bold leading-none text-white backdrop-blur-sm">@Model.Rating</span>
    }
    else
    {
        <div class="@theme.Art" aria-hidden="true"></div>
        <span class="absolute left-3 top-3 rounded-full border px-2 py-0.5 text-[10px] font-bold leading-none @theme.Badge">@Model.Rating</span>
        <p class="absolute inset-x-3 bottom-3 m-0 whitespace-pre-line text-2xl font-black uppercase leading-[0.9] tracking-tighter sm:text-3xl @theme.Text" aria-hidden="true">@(Model.PosterTitle ?? Model.Title)</p>
    }
</div>
