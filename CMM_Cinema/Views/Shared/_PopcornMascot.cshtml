@{
    // Matching M + ten C + Z commands let GSAP interpolate the two silhouettes directly.
    var popcornShape = "M128 338C89 330 72 287 96 248C62 216 84 166 122 157C109 115 138 81 177 87C187 48 245 43 266 82C310 64 344 96 337 132C379 141 386 186 362 214C397 260 367 292 332 300C329 343 280 370 246 351C217 388 157 376 151 342C143 342 135 339 128 338Z";
    var cupShape = "M150 330C145 300 137 240 132 190C129 166 125 144 124 128C125 120 150 115 180 114C205 112 235 112 260 114C291 115 314 120 316 128C313 153 307 192 302 223C296 265 291 307 286 330C282 344 253 352 222 352C192 352 158 347 150 330C150 330 150 330 150 330Z";
}
@* One layered character becomes Poppy or a water cup; the same face stays interactive. *@
<div class="popcorn-mascot mx-auto w-full max-w-[380px]" data-popcorn-mascot>
    <svg class="block h-auto w-full overflow-visible" viewBox="0 0 440 420" role="img" aria-labelledby="poppy-title" focusable="false">
        <title id="poppy-title" data-mascot-title>Poppy, a friendly fluffy popcorn mascot</title>
        <defs>
            <radialGradient id="poppy-body" cx="32%" cy="20%" r="82%">
                <stop offset="0" stop-color="white" />
                <stop offset="0.6" stop-color="var(--color-cinema-cream)" />
                <stop offset="1" stop-color="var(--color-cinema-sun)" />
            </radialGradient>
            <radialGradient id="cup-body" cx="30%" cy="20%" r="90%">
                <stop stop-color="color-mix(in srgb, var(--color-cinema-poster-red, #ff2638) 82%, var(--color-cinema-cream))" />
                <stop offset="0.45" stop-color="var(--color-cinema-poster-red, #ff2638)" />
                <stop offset="1" stop-color="color-mix(in srgb, var(--color-cinema-poster-red, #ff2638) 65%, var(--color-cinema-ink))" />
            </radialGradient>
            <radialGradient id="poppy-puff" cx="35%" cy="25%" r="75%">
                <stop offset="0" stop-color="white" stop-opacity="0.9" />
                <stop offset="1" stop-color="var(--color-cinema-cream)" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="poppy-eye" cx="30%" cy="25%" r="75%">
                <stop offset="0" stop-color="var(--color-cinema-deep)" />
                <stop offset="1" stop-color="var(--color-cinema-ink)" />
            </radialGradient>
            <radialGradient id="poppy-eye-white" cx="30%" cy="20%" r="85%">
                <stop stop-color="white" />
                <stop offset="1" stop-color="var(--color-cinema-linen)" />
            </radialGradient>
            <clipPath id="poppy-eye-left"><ellipse cx="170" cy="214" rx="26" ry="32" /></clipPath>
            <clipPath id="poppy-eye-right"><ellipse cx="267" cy="207" rx="26" ry="32" /></clipPath>
            <clipPath id="poppy-pupil-left"><ellipse cx="170" cy="214" rx="17" ry="23" /></clipPath>
            <clipPath id="poppy-pupil-right"><ellipse cx="267" cy="207" rx="17" ry="23" /></clipPath>
            <radialGradient id="poppy-shadow">
                <stop stop-color="var(--color-cinema-ink)" stop-opacity="0.24" />
                <stop offset="1" stop-color="var(--color-cinema-ink)" stop-opacity="0" />
            </radialGradient>
        </defs>
        <ellipse cx="222" cy="390" rx="138" ry="17" fill="url(#poppy-shadow)" />
        <g data-mascot-transition>
        <g class="popcorn-mascot__reaction" data-mascot-reaction>
            <g data-mascot-idle>
            <g class="popcorn-mascot__character">
                @await Html.PartialAsync("_CupSodaBubbles")
                <g class="auth-cup-details" data-mascot-cup-details>
                    <path d="M145 251C112 248 105 261 91 270M296 250C330 260 340 246 350 239" fill="none" stroke="var(--color-cinema-ink)" stroke-width="9" stroke-linecap="round" />
                    <g data-cup-straw>
                        <path d="M244 124 255 63Q257 49 271 45L299 36" fill="none" stroke="var(--color-cinema-ink)" stroke-width="17" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M244 124 255 63Q257 49 271 45L299 36" fill="none" stroke="var(--color-cinema-cyan)" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="m254 67 12 3m-15 14 12 3m6-41 4 11" stroke="var(--color-cinema-cream)" stroke-width="5" />
                    </g>
                </g>
                <ellipse cx="172" cy="367" rx="26" ry="17" fill="url(#poppy-body)" transform="rotate(-12 172 367)" />
                <ellipse cx="274" cy="367" rx="26" ry="17" fill="url(#poppy-body)" transform="rotate(12 274 367)" />
                <ellipse cx="91" cy="270" rx="20" ry="32" fill="url(#poppy-body)" transform="rotate(-28 91 270)" />
                <ellipse cx="350" cy="266" rx="20" ry="32" fill="url(#poppy-body)" transform="rotate(28 350 266)" />
                <path d="@popcornShape" fill="url(#poppy-body)" data-mascot-body data-shape-login="@popcornShape" data-shape-register="@cupShape" />
                <path class="auth-cup-details" d="@popcornShape" fill="url(#cup-body)" data-mascot-body data-mascot-cup-details />
                <g data-mascot-popcorn-details>
                <ellipse cx="166" cy="130" rx="50" ry="48" fill="url(#poppy-puff)" />
                <ellipse cx="228" cy="98" rx="51" ry="43" fill="url(#poppy-puff)" />
                <ellipse cx="300" cy="136" rx="46" ry="47" fill="url(#poppy-puff)" />
                <ellipse cx="124" cy="211" rx="37" ry="47" fill="url(#poppy-puff)" />
                <path d="M186 321Q217 296 247 320Q238 350 217 357Q193 346 186 321Z" fill="var(--color-cinema-sun)" opacity="0.25" />
                </g>
                <g class="auth-cup-details" data-mascot-cup-details>
                    <path d="M149 286Q221 306 292 286L286 326Q222 350 155 326Z" fill="var(--color-cinema-cream)" opacity="0.18" />
                    <path d="M150 148 166 300" fill="none" stroke="white" stroke-opacity="0.65" stroke-width="9" stroke-linecap="round" />
                    <ellipse cx="220" cy="128" rx="101" ry="21" fill="var(--color-cinema-ink)" />
                    <ellipse cx="220" cy="124" rx="99" ry="19" fill="var(--color-cinema-cream)" stroke="var(--color-cinema-ink)" stroke-width="2" />
                    <ellipse cx="220" cy="122" rx="80" ry="10" fill="var(--color-cinema-sky)" opacity="0.55" />
                    <ellipse cx="245" cy="122" rx="13" ry="5" fill="var(--color-cinema-ink)" />
                    <path d="m244 120 3-16" stroke="var(--color-cinema-cyan)" stroke-width="12" />
                    <circle cx="197" cy="313" r="7" fill="var(--color-cinema-cream)" opacity="0.9" />
                    <circle cx="237" cy="324" r="4" fill="var(--color-cinema-cream)" opacity="0.9" />
                    <path d="m259 300 7 11-7 11-7-11Z" fill="var(--color-cinema-cream)" opacity="0.9" />
                </g>
                <g data-mascot-face>
                    <ellipse cx="142" cy="250" rx="17" ry="9" fill="var(--color-cinema-brick)" opacity="0.13" />
                    <ellipse cx="291" cy="244" rx="17" ry="9" fill="var(--color-cinema-brick)" opacity="0.13" />
                    <g class="popcorn-mascot__eyes-open">
                        <g class="popcorn-mascot__eyeballs">
                            <ellipse cx="170" cy="214" rx="26" ry="32" fill="url(#poppy-eye-white)" />
                            <ellipse cx="267" cy="207" rx="26" ry="32" fill="url(#poppy-eye-white)" />
                            <g clip-path="url(#poppy-eye-left)">
                                <g class="popcorn-mascot__gaze">
                                    <ellipse cx="170" cy="214" rx="17" ry="23" fill="url(#poppy-eye)" />
                                    <g clip-path="url(#poppy-pupil-left)">
                                        <g class="popcorn-mascot__highlights" data-mascot-highlights>
                                            <ellipse cx="170" cy="210" rx="5" ry="7" fill="white" />
                                            <circle cx="176" cy="224" r="3" fill="white" opacity="0.25" />
                                        </g>
                                    </g>
                                </g>
                            </g>
                            <g clip-path="url(#poppy-eye-right)">
                                <g class="popcorn-mascot__gaze">
                                    <ellipse cx="267" cy="207" rx="17" ry="23" fill="url(#poppy-eye)" />
                                    <g clip-path="url(#poppy-pupil-right)">
                                        <g class="popcorn-mascot__highlights" data-mascot-highlights>
                                            <ellipse cx="267" cy="203" rx="5" ry="7" fill="white" />
                                            <circle cx="273" cy="217" r="3" fill="white" opacity="0.25" />
                                        </g>
                                    </g>
                                </g>
                            </g>
                        </g>
                    </g>
                    <g class="popcorn-mascot__eyes-closed" fill="none" stroke="var(--color-cinema-ink)" stroke-width="5" stroke-linecap="round">
                        <path d="M151 215Q170 231 189 215M248 208Q267 224 286 208" />
                    </g>
                    <path class="popcorn-mascot__smile" d="M209 255Q222 271 236 253" fill="none" stroke="var(--color-cinema-ink)" stroke-width="5" stroke-linecap="round" />
                    <ellipse class="popcorn-mascot__oops" cx="222" cy="260" rx="8" ry="10" fill="var(--color-cinema-ink)" />
                </g>
            </g>
            </g>
        </g>
        </g>
    </svg>
</div>
