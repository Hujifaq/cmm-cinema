@model NewsSectionViewModel
@{
    var first = Model.Items[0];
}

<section class="relative z-20 -mt-px overflow-hidden bg-cinema-paper pb-16 font-sans text-cinema-ink md:pb-24" aria-labelledby="@Model.Id-title" data-news>
    <div class="mx-auto max-w-[1440px] px-5 md:px-12">
        <h2 class="m-0 text-5xl font-black uppercase leading-none tracking-tighter sm:text-7xl md:text-8xl lg:text-[8rem]" id="@Model.Id-title">@Model.Title</h2>
        <a class="mt-6 inline-flex rounded-full bg-cinema-ink px-5 py-2 text-xs font-bold uppercase tracking-widest text-cinema-cream no-underline" href="#">View all</a>

        <div class="mt-8 grid items-center gap-8 md:mt-10 md:grid-cols-2 md:gap-12 lg:gap-24" aria-live="polite">
            <div class="aspect-video overflow-hidden rounded-2xl bg-cinema-ink/10" data-news-frame
                 data-title="@first.Title" data-category="@first.Category" data-date="@first.Date" data-image="@first.Image" data-excerpt="@first.Excerpt" data-url="@first.Url">
                <img class="size-full object-cover" src="@first.Image" alt="@first.Title" width="1200" height="675" data-news-image />
            </div>
            <div class="max-w-xl">
                <p class="m-0 text-[10px] font-bold uppercase tracking-widest text-cinema-ink/60" data-news-meta><span data-news-category>@first.Category</span> · <span data-news-date>@first.Date</span></p>
                <h3 class="m-0 mt-2 text-2xl font-extrabold leading-tight md:text-3xl" data-news-title>@first.Title</h3>
                <p class="m-0 mt-4 text-lg leading-snug md:text-xl" data-news-excerpt>@first.Excerpt</p>
                <a class="news-link relative mt-8 inline-block text-sm font-bold uppercase tracking-wide text-cinema-ink no-underline" href="@first.Url" data-news-link>
                    <span class="relative z-10">Read more</span>
                    <svg class="news-underline pointer-events-none absolute inset-x-[-3%] -bottom-2.5 z-0 h-3 w-[106%]" viewBox="0 0 200 14" fill="none" stroke="currentColor" stroke-linecap="round" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                        <path d="M3 4.5 C40 2.5 90 4 130 3 S180 3.5 197 2.8" stroke-width="2.6" vector-effect="non-scaling-stroke" />
                        <path d="M14 10.5 C60 9.2 105 10.8 150 9.8 S178 10 188 9.6" stroke-width="2" vector-effect="non-scaling-stroke" opacity="0.85" />
                    </svg>
                    @await Html.PartialAsync("_AnnotationHighlight")
                </a>
            </div>
        </div>

        <div class="swiper news-swiper mt-10 md:mt-14" data-news-swiper>
            <div class="swiper-wrapper">
                @foreach (var item in Model.Items.Skip(1))
                {
                    <div class="swiper-slide h-auto">
                        <button type="button" class="news-thumb block w-full cursor-pointer rounded-2xl border-0 bg-transparent p-0 text-left" aria-label="Show story: @item.Title"
                                data-news-thumb data-title="@item.Title" data-category="@item.Category" data-date="@item.Date" data-image="@item.Image" data-excerpt="@item.Excerpt" data-url="@item.Url">
                            <span class="block aspect-video overflow-hidden rounded-2xl bg-cinema-ink/10">
                                <img class="news-thumb__image size-full object-cover" src="@item.Image" alt="" width="1200" height="675" loading="lazy" />
                            </span>
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="mt-6 flex justify-center gap-6 md:gap-24">
            <button type="button" class="cursor-pointer rounded-md border border-cinema-ink bg-transparent px-4 py-1.5 text-sm font-semibold text-cinema-ink disabled:cursor-default disabled:opacity-40" data-news-prev>‹ Prev</button>
            <button type="button" class="cursor-pointer rounded-md border border-cinema-ink bg-transparent px-4 py-1.5 text-sm font-semibold text-cinema-ink disabled:cursor-default disabled:opacity-40" data-news-next>Next ›</button>
        </div>
    </div>
</section>
