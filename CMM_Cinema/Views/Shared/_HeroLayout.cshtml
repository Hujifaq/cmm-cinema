<!DOCTYPE html>
<html lang="en" class="m-0 min-w-[280px] bg-cinema-deep p-0 scheme-dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#103d3e" />
    <meta name="description" content="CMM Cinema. A little movie magic." />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/images/favicon-192.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" asp-append-version="true" />
    <style nonce="@Context.GetNonce()">
        @@media @(ViewData["NewsPage"] is true ? "" : "(min-width: 768px) and ")(prefers-reduced-motion: no-preference) {
            @@view-transition { navigation: auto; }
        }
    </style>
    <script nonce="@Context.GetNonce()">
        
        window.addEventListener('pagereveal', function (event) {
            var handoff = '';
            try { handoff = sessionStorage.getItem('cmm-news-handoff') || ''; sessionStorage.removeItem('cmm-news-handoff'); } catch (e) {}
            if (!event.viewTransition) return;
            document.documentElement.setAttribute('data-page-arrived', '');
          
            if (handoff === 'drop') { document.documentElement.setAttribute('data-news-drop', ''); return; }
            if (handoff || !window.matchMedia('(min-width: 768px)').matches) {
                var vt = event.viewTransition;
                vt.ready.catch(function () {}); vt.finished.catch(function () {}); vt.updateCallbackDone.catch(function () {});
                vt.skipTransition();
            }
        });
    </script>
    <link rel="stylesheet" href="~/lib/swiper/swiper-bundle.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/lenis/lenis.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cinema-nav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/page-transition.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="m-0 min-w-[280px] p-0">
    @await RenderSectionAsync("TopBanner", required: false)
    @await Html.PartialAsync("_CinemaNav")
    <main class="m-0 p-0">@RenderBody()</main>
    <div id="cinema-search-root" nonce="@Context.GetNonce()"></div>
    <script src="~/lib/lenis/lenis.min.js" asp-append-version="true" defer></script>
    <script src="~/js/smooth-scroll.js" asp-append-version="true" defer></script>
    <script src="~/lib/gsap/gsap.min.js" asp-append-version="true" defer></script>
    <script src="~/lib/gsap/SplitText.min.js" asp-append-version="true" defer></script>
    <script src="~/js/page-transition.js" asp-append-version="true" defer></script>
    <script src="~/js/hero-physics.js" asp-append-version="true" defer></script>
    <script src="~/js/hero.js" asp-append-version="true" defer></script>
    <script src="~/js/gooey-nav.js" asp-append-version="true" defer></script>
    <script src="~/js/cinema-nav.js" asp-append-version="true" defer></script>
    <script src="~/js/cinema-nav-actions.js" asp-append-version="true" defer></script>
    <script src="~/js/cinema-search.bundle.js" asp-append-version="true" defer></script>
    <script src="~/js/now-showing-title.bundle.js" asp-append-version="true" defer></script>
    <script src="~/js/cinema-marquee.js" asp-append-version="true" defer></script>
    <script src="~/lib/swiper/swiper-bundle.min.js" asp-append-version="true" defer></script>
    <script src="~/js/cinema-promos.js" asp-append-version="true" defer></script>
    <script src="~/js/now-showing.js" asp-append-version="true" defer></script>
    <script src="~/js/news.js" asp-append-version="true" defer></script>
    <script src="~/js/cinema-magnetic.js" asp-append-version="true" defer></script>
    <script src="~/js/quick-book.js" asp-append-version="true" defer></script>
    <script src="~/js/movie-detail.js" asp-append-version="true" defer></script>
    <script src="~/js/goo-button.js" asp-append-version="true" defer></script>
    <script src="~/js/my-tickets.js" asp-append-version="true" defer></script>
    <script src="~/js/signup.js" asp-append-version="true" defer></script>
    <script src="~/js/forgot-password.js" asp-append-version="true" defer></script>
    <script src="~/js/ajax-form.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
