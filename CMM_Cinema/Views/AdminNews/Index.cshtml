@model IReadOnlyList<NewsAdminRow>
@{
    Context.RequireAssets("admin-news");
    Layout = "_HeroLayout";
    ViewData["Title"] = "Manage news - CMM Cinema";
    ViewData["AddHref"] = (bool)(ViewData["CanEdit"] ?? false) ? "/Admin/News/New" : null;
    ViewData["AddLabel"] = "Add story";
    var canEdit = (bool)(ViewData["CanEdit"] ?? false);
    var now = DateTimeOffset.UtcNow;
    var visible = Model.Count(row => row.StateAt(now) == NewsState.Published);
    var chipClass = "inline-flex items-center rounded-full px-3 py-1.5 text-[11px] font-bold leading-none";
    var pillClass = "inline-flex min-h-11 cursor-pointer items-center justify-center rounded-full px-5 text-sm font-bold no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-ink";
}

@section TopBanner {
    @await Html.PartialAsync("_CinemaMarquee")
}

<section class="min-h-screen overflow-x-clip bg-cinema-paper pb-16 pt-32 font-sans text-cinema-ink md:pb-24 md:pt-40" aria-labelledby="admin-news-title">
    @await Html.PartialAsync("_AdminBar")
    <div class="mx-auto max-w-[1440px] px-5 md:px-12">
        @await Html.PartialAsync("_Breadcrumb", new (string, string?)[] { ("Home", "/"), ("News", "/News"), ("Manage news", null) })
        <h1 class="m-0 text-5xl font-black uppercase leading-[0.9] tracking-tighter sm:text-6xl lg:text-7xl" id="admin-news-title">Manage news</h1>

        @if (!canEdit)
        {
            <p class="mb-0 mt-8 rounded-2xl bg-cinema-ink/[0.04] px-5 py-4 text-sm leading-relaxed text-cinema-ink/70">News can only be edited once the Cloudflare D1 database is configured. Until then the site shows no news.</p>
        }
        else if (Model.Count == 0)
        {
            <div class="mt-8 grid justify-items-start gap-4 rounded-[28px] border border-dashed border-cinema-ink/25 p-8">
                <p class="m-0 text-lg font-extrabold">No stories yet</p>
                <p class="m-0 text-sm text-cinema-ink/60">Add your first story with a landscape movie poster as its cover.</p>
                <a class="@pillClass bg-cinema-ink text-cinema-cream" href="/Admin/News/New">Add story</a>
            </div>
        }
        else
        {
            <p class="mb-0 mt-4 text-sm leading-relaxed text-cinema-ink/60">@Model.Count @(Model.Count == 1 ? "story" : "stories"), @visible live on the site. Drafts and scheduled stories stay hidden; the site shows the 12 newest live stories.</p>

            <ul class="m-0 mt-8 grid list-none gap-4 p-0">
                @foreach (var row in Model)
                {
                    var state = row.StateAt(now);
                    <li class="grid gap-4 rounded-[28px] bg-white p-4 shadow-clay sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-center sm:p-5 lg:grid-cols-[11rem_minmax(0,1fr)_auto]">
                        <span class="block aspect-video overflow-hidden rounded-2xl bg-cinema-ink/10">
                            <img class="size-full object-cover object-[50%_20%]" src="@row.LandscapeUrl" alt="" width="352" height="198" loading="lazy" />
                        </span>
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                @if (state == NewsState.Published)
                                {
                                    <span class="@chipClass bg-cinema-logo text-white shadow-clay-pill">Published</span>
                                }
                                else if (state == NewsState.Scheduled)
                                {
                                    <span class="@chipClass bg-cinema-cyan/25 text-cinema-ink">Scheduled</span>
                                }
                                else
                                {
                                    <span class="@chipClass border border-solid border-cinema-ink/40 text-cinema-ink/70">Draft</span>
                                }
                                <span class="text-[10px] font-bold uppercase tracking-widest text-cinema-ink/60">@row.Category · @row.Date</span>
                            </div>
                            <h2 class="m-0 mt-2 break-words text-lg font-extrabold leading-tight md:text-xl">@row.Title</h2>
                            @if (row.MovieTitle is not null)
                            {
                                <p class="mb-0 mt-1 text-sm text-cinema-ink/60">About @row.MovieTitle</p>
                            }
                        </div>
                        <div class="flex flex-wrap gap-2 sm:col-span-2 lg:col-span-1 lg:justify-end">
                            @if (state == NewsState.Published)
                            {
                                <a class="@pillClass border border-solid border-cinema-ink/20 bg-transparent text-cinema-ink" href="@row.Url">View</a>
                            }
                            <a class="@pillClass bg-cinema-ink text-cinema-cream" href="/Admin/News/@row.Id/Edit" aria-label="Edit @row.Title">Edit</a>
                            <button class="@pillClass border-0 bg-cinema-brick text-cinema-cream" type="button" data-admin-story-delete data-admin-story-id="@row.Id" data-admin-story-title="@row.Title" aria-label="Delete @row.Title">Delete</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>

    <dialog class="m-auto w-[min(92vw,26rem)] rounded-[28px] border-0 bg-cinema-paper p-0 font-sans text-cinema-ink shadow-clay backdrop:bg-black/50 backdrop:backdrop-blur-sm" aria-labelledby="delete-news-title" data-admin-story-delete-dialog>
        <form class="grid gap-5 p-7" method="post" asp-controller="AdminNews" asp-action="Delete">
            <input type="hidden" name="id" data-admin-story-delete-id />
            <div>
                <h2 class="m-0 text-2xl font-black leading-tight tracking-tight" id="delete-news-title">Delete this story?</h2>
                <p class="mb-0 mt-2 text-sm leading-relaxed text-cinema-ink/70"><strong data-admin-story-delete-name>This story</strong> will be removed from the site for good. To hide it for now, edit it and switch it to a draft instead.</p>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <button class="min-h-11 cursor-pointer rounded-full border border-solid border-cinema-ink/20 bg-white px-5 text-sm font-bold text-cinema-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-ink" type="button" data-admin-story-delete-cancel autofocus>Keep it</button>
                <button class="min-h-11 cursor-pointer rounded-full border-0 bg-cinema-brick px-5 text-sm font-bold text-cinema-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-brick" type="submit">Yes, delete</button>
            </div>
        </form>
    </dialog>
</section>

