@model string
@{
    Layout = "_HeroLayout";
    ViewData["Title"] = "Check your email - CMM Cinema";
}

@section TopBanner {
    @await Html.PartialAsync("_CinemaMarquee")
}

<section class="flex min-h-[calc(100svh_-_36px)] items-center justify-center bg-cinema-paper px-5 pb-14 pt-28 font-sans text-cinema-ink scheme-light md:pb-20 md:pt-36" aria-labelledby="check-email-title" data-forgot-password-page>
    @await Html.PartialAsync("_GooFilter")
    <div class="w-full max-w-[480px] rounded-[28px] bg-cinema-paper p-6 text-center shadow-clay ring-1 ring-cinema-ink/10 sm:p-10" data-reset-card>
        <svg class="mx-auto mb-6 size-12 text-cinema-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" data-reveal-up><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <h1 class="m-0 text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl" id="check-email-title" data-reveal-chars>Check your email</h1>
        <p class="mb-0 mt-3 text-sm leading-relaxed text-cinema-ink/60" data-reveal-up>
            We sent a link to <strong class="break-all text-cinema-ink">@Model</strong>. Open it to confirm your email and finish creating your account.
        </p>
        @if (ViewData["Resent"] is true)
        {
            <p class="mb-0 mt-4 rounded-2xl bg-cinema-cyan/15 px-4 py-3 text-sm font-bold leading-relaxed text-cinema-ink" role="status" data-reveal-up>We sent a new link. Only the newest one works.</p>
        }
        <p class="mb-0 mt-4 rounded-2xl bg-cinema-ink/[0.04] px-4 py-3 text-xs leading-relaxed text-cinema-ink/60" data-reveal-up>
            The link expires in 24 hours. Can't find it? Check your spam folder, or send it again.
        </p>
        <div class="mt-6">
            <partial name="_ResendVerificationForm" model="Model" />
        </div>
        <div class="mt-3" data-reveal-up>
            <a class="inline-flex min-h-[44px] items-center justify-center gap-2 text-sm font-bold text-cinema-ink underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-ink" asp-controller="LoginRegister" asp-action="Index">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 12H4m6-6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Back to login
            </a>
        </div>
    </div>
</section>

@await Html.PartialAsync("_AccountFooter")
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
