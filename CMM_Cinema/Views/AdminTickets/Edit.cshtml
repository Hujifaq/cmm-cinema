@model AdminTicketEditViewModel
@{ Context.RequireAssets("admin-tickets"); }
@{
    Layout = "_HeroLayout";
    ViewData["Title"] = $"Edit ticket {Model.Ticket.BookingCode} - CMM Cinema";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var notice = TempData["AdminNotice"] as string;
    var selected = Model.SelectedShowtime;
    var moving = selected.Id != Model.CurrentShowtime.Id;
    var archived = Model.Ticket.Movie.IsArchived;
    var canEditSeats = selected.IsBookable && !archived;
    var zones = Model.Seats.GroupBy(seat => seat.Category).OrderBy(zone => zone.Key).ToArray();

    var panelClass = "rounded-[28px] border border-solid border-cinema-ink/15 bg-white p-5 sm:p-7";
    var labelClass = "m-0 text-[10px] font-bold uppercase tracking-widest text-cinema-ink/60";
    var headingClass = "m-0 text-2xl font-black uppercase leading-none tracking-tighter sm:text-3xl";
    var primaryClass = "inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-full border-0 bg-cinema-ink px-6 font-sans text-sm font-bold text-cinema-cream transition-colors duration-300 hover:bg-cinema-logo focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-ink motion-reduce:transition-none";
    var secondaryClass = "inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-full border border-solid border-cinema-ink bg-transparent px-6 font-sans text-sm font-bold text-cinema-ink transition-colors duration-300 hover:bg-cinema-ink/[0.06] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-ink motion-reduce:transition-none";
    var seatClass = "relative inline-grid h-11 shrink-0 cursor-pointer select-none place-items-center rounded-full border border-solid border-cinema-ink/20 bg-white text-xs font-bold text-cinema-ink transition-colors duration-200 hover:border-cinema-ink has-checked:border-cinema-logo has-checked:bg-cinema-logo has-checked:text-white has-disabled:cursor-not-allowed has-disabled:border-transparent has-disabled:bg-cinema-ink/10 has-disabled:text-cinema-ink/30 has-disabled:line-through has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-cinema-ink motion-reduce:transition-none";

    string Describe(Showtime showtime) =>
        $"{showtime.Time.ToString("HH:mm", culture)} · {BookingRules.GetCinema(showtime.CinemaId)?.Name} · {showtime.Format} {showtime.Language}";
}

<section class="min-h-screen overflow-x-clip bg-cinema-paper pb-16 pt-32 font-sans text-cinema-ink md:pb-24 md:pt-40" aria-labelledby="edit-ticket-title">
    <div class="mx-auto max-w-6xl px-5 md:px-12">
        @await Html.PartialAsync("_Breadcrumb", new (string, string?)[] { ("Home", "/"), ("My Tickets", "/MyTickets"), ($"Edit {Model.Ticket.BookingCode}", null) })
        <p class="m-0 mb-5 inline-flex items-center rounded-full bg-cinema-ink px-4 py-2 text-[11px] font-bold uppercase tracking-widest text-cinema-cream">Logged in as ADMIN</p>
        <h1 class="m-0 text-5xl font-black uppercase leading-[0.9] tracking-tighter sm:text-6xl lg:text-7xl" id="edit-ticket-title">Edit Ticket</h1>
        <p class="m-0 mt-4 max-w-2xl text-sm leading-relaxed text-cinema-ink/70">Changes keep the booking code and QR code, so the customer's ticket keeps working and shows the new details.</p>

        @if (notice is not null)
        {
            <p class="m-0 mt-5 inline-flex rounded-full bg-cinema-logo px-4 py-2 text-sm font-bold text-white shadow-clay-pill" role="status">@notice</p>
        }
        @if (Model.Error is not null)
        {
            <p class="m-0 mt-5 rounded-[20px] border border-solid border-cinema-brick/40 bg-cinema-brick/10 px-5 py-3 text-sm font-semibold text-cinema-brick" role="alert">@Model.Error</p>
        }

        <div class="mt-8 grid gap-6 md:mt-10">
            <article class="@panelClass grid gap-6 lg:grid-cols-[minmax(0,1fr)_280px]" aria-labelledby="edit-ticket-movie">
                @await Html.PartialAsync("_TicketSummary", Model.Ticket, new ViewDataDictionary(ViewData) { ["TitleId"] = "edit-ticket-movie" })
                <dl class="m-0 grid content-start gap-4 border-0 border-t border-dashed border-cinema-ink/20 pt-5 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0">
                    <div>
                        <dt class="@labelClass">Customer</dt>
                        <dd class="m-0 mt-1 break-words text-base font-extrabold">@Model.Owner.Name</dd>
                        <dd class="m-0 break-words text-sm text-cinema-ink/60">@Model.Owner.DisplayEmail</dd>
                    </div>
                    <div>
                        <dt class="@labelClass">@(Model.Ticket.Seats.Count == 1 ? "Seat" : "Seats")</dt>
                        <dd class="m-0 mt-1 text-2xl font-black uppercase leading-none tracking-tighter">@string.Join(", ", Model.Ticket.Seats)</dd>
                    </div>
                    <div>
                        <dt class="@labelClass">Total</dt>
                        <dd class="m-0 mt-1 text-base font-extrabold">฿@Model.Booking.Total.ToString("N0", culture) · @Model.Booking.TicketCount @(Model.Booking.TicketCount == 1 ? "admission" : "admissions")</dd>
                    </div>
                    <div>
                        <a class="border-0 border-b-2 border-solid border-cinema-ink pb-0.5 text-sm font-bold text-cinema-ink no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-ink" href="/t/@Model.Ticket.TicketToken" target="_blank" rel="noopener">Open the QR ticket page</a>
                    </div>
                </dl>
            </article>

            <section class="@panelClass" aria-labelledby="edit-screening-title">
                <h2 class="@headingClass" id="edit-screening-title">Screening</h2>
                <p class="m-0 mt-2 text-sm text-cinema-ink/60">Booked for @Model.CurrentShowtime.Date.ToString("ddd d MMM", culture) · @Describe(Model.CurrentShowtime)@(Model.CurrentShowtime.HasStarted ? " (already started)" : "").</p>
                <form class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-end [&[hidden]]:hidden" hidden="@archived" method="get" action="/Admin/Tickets/@Model.Booking.Id.ToString("D")">
                    <label class="grid min-w-0 flex-1 gap-1.5">
                        <span class="@labelClass">Move to</span>
                        <span class="relative block">
                            <select class="min-h-12 w-full cursor-pointer appearance-none rounded-full border border-solid border-cinema-ink/20 bg-white py-0 pl-5 pr-12 font-sans text-sm font-semibold text-cinema-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-ink" name="showtimeId">
                                @foreach (var day in Model.Showtimes.GroupBy(showtime => showtime.Date))
                                {
                                    <optgroup label="@day.Key.ToString("dddd d MMM", culture)">
                                        @foreach (var showtime in day)
                                        {
                                            <option value="@showtime.Id" selected="@(showtime.Id == selected.Id)">@Describe(showtime)@(showtime.Id == Model.CurrentShowtime.Id ? " (current)" : "")</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <svg class="pointer-events-none absolute right-5 top-1/2 size-4 -translate-y-1/2" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 8 5 5 5-5" /></svg>
                        </span>
                    </label>
                    <button class="@secondaryClass" type="submit">Show seats</button>
                </form>
                @if (archived)
                {
                    <p class="m-0 mt-4 text-sm font-semibold">This movie was deleted, so it has no new screenings. The ticket stays valid for its original screening, and you can still cancel it below.</p>
                }
                @if (moving)
                {
                    <p class="m-0 mt-4 text-sm font-semibold">Moving to @selected.Date.ToString("ddd d MMM", culture) · @Describe(selected). The ticket's seats are ticked where they are free on this screening.</p>
                }
            </section>

            <section class="@panelClass" aria-labelledby="edit-seats-title">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <h2 class="@headingClass" id="edit-seats-title">Seats</h2>
                    <p class="m-0 text-sm text-cinema-ink/60">Up to @BookingRules.MaxSeatsPerBooking admissions. A VIP pair counts as 2.</p>
                </div>

                @if (archived)
                {
                    <p class="m-0 mt-4 text-sm font-semibold">Seats can't change on a deleted movie's ticket.</p>
                }
                else if (!canEditSeats)
                {
                    <p class="m-0 mt-4 text-sm font-semibold">This screening has already started, so its seats can't change. Pick another screening above to move the ticket, or cancel it below.</p>
                }
                else
                {
                    <form class="mt-5 grid gap-6" method="post" action="/Admin/Tickets/@Model.Booking.Id.ToString("D")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="showtimeId" value="@selected.Id" />
                        <div class="overflow-x-auto pb-2">
                            <div class="mx-auto grid w-max gap-5">
                                <p class="m-0 rounded-full bg-cinema-ink/[0.07] py-2 text-center text-[10px] font-bold uppercase tracking-[0.4em] text-cinema-ink/60" aria-hidden="true">Screen</p>
                                @foreach (var zone in zones)
                                {
                                    <fieldset class="m-0 grid gap-2 border-0 p-0">
                                        <legend class="mb-2 p-0 text-xs font-bold">@zone.Key.DisplayName() · ฿@BookingRules.GetSeatPrice(zone.Key).ToString("N0", culture)@(zone.Key == SeatCategory.Vip ? " per pair" : "")</legend>
                                        @foreach (var row in zone.GroupBy(seat => seat.Row).OrderByDescending(row => row.Key))
                                        {
                                            <div class="flex items-center gap-1.5">
                                                <span class="w-8 shrink-0 text-center text-xs font-black text-cinema-ink/50" aria-hidden="true">@row.Key</span>
                                                @foreach (var seat in row.OrderBy(seat => seat.Number))
                                                {
                                                    var sold = seat.State == SeatState.Sold;
                                                    <label class="@seatClass @(seat.Capacity == 2 ? "w-[94px]" : "w-11")">
                                                        <input class="sr-only" type="checkbox" name="seatIds" value="@seat.Id" checked="@Model.SelectedSeats.Contains(seat.Id)" disabled="@sold" aria-label="@seat.Category.DisplayName() @seat.Id@(sold ? ", taken" : "")" />
                                                        @(seat.Capacity == 2 ? seat.Id : seat.Number.ToString(culture))
                                                    </label>
                                                }
                                            </div>
                                        }
                                    </fieldset>
                                }
                            </div>
                        </div>
                        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                            <p class="m-0 flex flex-wrap items-center gap-4 text-xs font-semibold text-cinema-ink/70">
                                <span class="inline-flex items-center gap-2"><span class="size-4 rounded-full bg-cinema-logo" aria-hidden="true"></span>This ticket</span>
                                <span class="inline-flex items-center gap-2"><span class="size-4 rounded-full border border-solid border-cinema-ink/20 bg-white" aria-hidden="true"></span>Free</span>
                                <span class="inline-flex items-center gap-2"><span class="size-4 rounded-full bg-cinema-ink/10" aria-hidden="true"></span>Taken</span>
                            </p>
                            <button class="@primaryClass" type="submit">Save changes</button>
                        </div>
                    </form>
                }
            </section>

            <section class="@panelClass flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" aria-labelledby="cancel-ticket-title">
                <div>
                    <h2 class="@headingClass" id="cancel-ticket-title">Cancel ticket</h2>
                    <p class="m-0 mt-2 text-sm text-cinema-ink/60">Removes the booking and frees its seats. The QR code stops working.</p>
                </div>
                <form method="post" action="/Admin/Tickets/@Model.Booking.Id.ToString("D")/Cancel">
                    @Html.AntiForgeryToken()
                    <button class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-full border-0 bg-cinema-brick px-6 font-sans text-sm font-bold text-cinema-cream focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-brick" type="submit" data-admin-ticket-cancel>Cancel ticket</button>
                </form>
            </section>
        </div>
    </div>

    <dialog class="m-auto w-[min(92vw,26rem)] rounded-[28px] border-0 bg-cinema-paper p-0 font-sans text-cinema-ink shadow-clay backdrop:bg-black/50 backdrop:backdrop-blur-sm" aria-labelledby="cancel-ticket-dialog-title" data-admin-ticket-dialog>
        <form class="grid gap-5 p-7" method="post" action="/Admin/Tickets/@Model.Booking.Id.ToString("D")/Cancel">
            @Html.AntiForgeryToken()
            <div>
                <h2 class="m-0 text-2xl font-black leading-tight tracking-tight" id="cancel-ticket-dialog-title">Cancel this ticket?</h2>
                <p class="mb-0 mt-2 text-sm leading-relaxed text-cinema-ink/70"><strong>@Model.Ticket.BookingCode</strong> for @Model.Owner.Name will be removed and its seats freed. This can't be undone.</p>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <button class="min-h-11 cursor-pointer rounded-full border border-solid border-cinema-ink/20 bg-white px-5 text-sm font-bold text-cinema-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-ink" type="button" data-admin-ticket-dialog-close autofocus>Keep it</button>
                <button class="min-h-11 cursor-pointer rounded-full border-0 bg-cinema-brick px-5 text-sm font-bold text-cinema-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cinema-brick" type="submit">Yes, cancel</button>
            </div>
        </form>
    </dialog>
</section>
