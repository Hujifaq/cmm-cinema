@model PromotionFormViewModel
@{
    Context.RequireAssets("admin-promotions");
    Layout = "_HeroLayout";
    var form = Model.Form;
    ViewData["Title"] = (Model.IsNew ? "Add banner" : "Edit banner") + " - CMM Cinema";
    var inputClass = "block min-h-11 w-full min-w-0 rounded-2xl border border-solid border-cinema-ink/15 bg-white px-4 py-2.5 font-sans text-base text-cinema-ink shadow-sm placeholder:text-cinema-ink/40 focus:outline-none focus-visible:border-cinema-ink";
    var labelClass = "mb-2 block text-[11px] font-bold uppercase tracking-widest text-cinema-ink/70";
    var hintClass = "m-0 mt-1.5 text-xs text-cinema-ink/60";
    var summary = ViewData.ModelState.Where(entry => entry.Value!.Errors.Count > 0).SelectMany(entry => entry.Value!.Errors).Select(error => error.ErrorMessage).Distinct().ToList();
    var imageError = ViewData.ModelState.TryGetValue(nameof(PromotionForm.ImageUrl), out var image) && image.Errors.Count > 0 ? image.Errors[0].ErrorMessage : null;
}

@section TopBanner {
    @await Html.PartialAsync("_CinemaMarquee")
}

<section class="min-h-screen overflow-x-clip bg-cinema-paper pb-16 pt-32 font-sans text-cinema-ink md:pb-24 md:pt-40" aria-labelledby="promo-form-title">
    @await Html.PartialAsync("_AdminBar")
    <div class="mx-auto max-w-3xl px-5 md:px-8">
        <h1 class="m-0 text-4xl font-black uppercase leading-[0.9] tracking-tighter sm:text-5xl" id="promo-form-title">@(Model.IsNew ? "Add banner" : "Edit banner")</h1>

        <form class="mt-8 grid gap-8" method="post">
            @if (summary.Count > 0)
            {
                <div class="rounded-2xl bg-cinema-brick/10 p-4 text-sm font-semibold text-cinema-brick" role="alert">
                    <p class="m-0">Please fix the following before saving:</p>
                    <ul class="m-0 mt-1 list-disc pl-5">
                        @foreach (var message in summary) { <li>@message</li> }
                    </ul>
                </div>
            }

            <fieldset class="m-0 grid gap-5 border-0 p-0">
                <legend class="mb-1 p-0 text-2xl font-black uppercase tracking-tighter">Banner image</legend>
                <div>
                    <label class="@labelClass" for="ImageUrl">Banner image link</label>
                    <input class="@inputClass" id="ImageUrl" name="ImageUrl" type="url" value="@form.ImageUrl" maxlength="500" placeholder="https://..." required aria-describedby="promo-note" data-promo-input />
                    <p class="@hintClass">A full https:// link to a 16:9 banner, at least 1400 × 788. The banner's own text is part of the picture, so nothing is cropped or added over it.</p>
                    @if (form.IsLocal)
                    {
                        <p class="@hintClass">This is one of the built-in launch banners. Paste a new link to replace it.</p>
                    }
                </div>
                <div>
                    <p class="@labelClass">How it will look</p>
                    <div class="aspect-video w-full max-w-xl overflow-hidden rounded-2xl bg-cinema-ink/10">
                        <img class="size-full object-cover" src="@form.ImageUrl" alt="" width="1200" height="675" data-promo-image hidden="@string.IsNullOrEmpty(form.ImageUrl)" />
                    </div>
                    <p class="m-0 mt-2 text-xs font-semibold text-cinema-ink/60 data-[tone=error]:text-cinema-brick" id="promo-note" role="status" data-promo-note data-tone="@(imageError is null ? null : "error")">@(imageError ?? (string.IsNullOrEmpty(form.ImageUrl) ? "Paste a link to see the banner here." : ""))</p>
                </div>
            </fieldset>

            <fieldset class="m-0 grid gap-5 border-0 p-0">
                <legend class="mb-1 p-0 text-2xl font-black uppercase tracking-tighter">Details</legend>
                <div>
                    <label class="@labelClass" for="Alt">Describe the banner</label>
                    <textarea class="@inputClass min-h-24 rounded-3xl" id="Alt" name="Alt" maxlength="300" required>@form.Alt</textarea>
                    <p class="@hintClass">Read aloud by screen readers and used by the site search. Start with the offer, for example "Orange banner: movie tickets 20% off this weekend".</p>
                </div>
                <label class="flex min-h-11 cursor-pointer items-center gap-3 text-sm font-bold">
                    <input class="size-5 cursor-pointer accent-cinema-ink" type="checkbox" name="IsActive" value="true" checked="@form.IsActive" />
                    <input type="hidden" name="IsActive" value="false" />
                    Shown on the home page (untick to hide it without deleting)
                </label>
            </fieldset>

            <div class="flex flex-wrap gap-3">
                <button class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-full border-0 bg-cinema-ink px-8 text-sm font-bold text-cinema-cream transition-colors duration-300 hover:bg-cinema-logo focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-ink motion-reduce:transition-none" type="submit">@(Model.IsNew ? "Add banner" : "Save changes")</button>
                <a class="inline-flex min-h-12 items-center justify-center rounded-full border border-solid border-cinema-ink/20 px-8 text-sm font-bold text-cinema-ink no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-ink" href="/Admin/Promotions">Cancel</a>
            </div>
        </form>
    </div>
</section>
