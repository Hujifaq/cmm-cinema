@model BookingDetailsViewModel
@using System.Globalization
@inject CMM_Cinema.Services.TicketQrService Qr
@{
    ViewData["Title"] = "Booking Confirmed";
    var culture = CultureInfo.InvariantCulture;
    var booking = Model.Booking;
    var seats = string.Join(", ", booking.SeatItems.Select(seat => seat.Capacity == 2 ? $"{seat.Id} (pair)" : seat.Id));
    var pillClass = "inline-flex min-h-12 w-full items-center justify-center whitespace-nowrap rounded-full px-6 text-center text-sm font-bold leading-snug no-underline transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-ink motion-reduce:transition-none sm:w-auto";
    var detailLabelClass = "mb-2 text-xs font-medium text-cinema-cream/55";
}

<div class="bk-flow bk-success">
    @await Html.PartialAsync("_BookingSteps", 4)

    <header class="mx-auto mb-8 max-w-[480px] text-center">
        <h1 class="m-0 text-3xl font-black leading-tight tracking-tight text-cinema-ink sm:text-4xl">Booking confirmed.</h1>
        <p class="mb-0 mt-3 text-sm leading-relaxed text-cinema-ink/65">Your booking is confirmed. This is a sample confirmation only: it is not a valid cinema ticket and no money was charged.</p>
    </header>

    <article class="bk-admission-ticket mx-auto w-full max-w-[480px] text-cinema-cream" aria-labelledby="confirmed-movie-title" data-ticket-tear>
        <div class="bk-admission-upper">
            <div class="relative aspect-[2/3] overflow-hidden" aria-hidden="true">
                @await Html.PartialAsync("_MoviePoster", Model.Movie)
                <span class="absolute bottom-5 left-5 inline-flex items-center gap-2 rounded-full bg-cinema-cream px-4 py-2 text-xs font-bold text-cinema-ink shadow-sm sm:bottom-6 sm:left-6">
                    <svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4 10 4 4 8-8" /></svg>
                    Demo confirmed
                </span>
            </div>
            <div class="px-6 pb-5 pt-6 sm:px-8 sm:pt-7">
                <h2 id="confirmed-movie-title" class="m-0 break-words text-2xl font-black uppercase leading-tight tracking-tight sm:text-3xl">@Model.Movie.Title</h2>
            </div>

            <div class="bk-admission-perforation bk-admission-perforation--upper" data-ticket-seam aria-hidden="true"><span></span></div>
        </div>

        <div class="bk-admission-lower" data-ticket-stub>
            <div class="bk-admission-perforation bk-admission-perforation--lower" aria-hidden="true"><span></span></div>
            <div class="px-6 pb-7 pt-5 sm:px-8 sm:pb-8">
                <p class="m-0 text-xl font-bold leading-snug">@Model.Cinema.Name</p>
                <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-cinema-cream/80">
                    <span class="rounded-md border border-solid border-cinema-cream/25 px-2 py-1 font-bold">@Model.Showtime.Format</span>
                    <span class="px-1">@Model.Showtime.Language</span>
                    <span class="rounded-md border border-solid border-cinema-cream/25 px-2 py-1 font-bold">@Model.Movie.Rating</span>
                    <span class="px-1">@(Model.Movie.DurationMinutes)m</span>
                </div>

                <dl class="mb-0 mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm">
                    <div class="flex items-center gap-2">
                        <dt><span class="sr-only">Screening date</span><svg class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 11h18m-13 4h1m6 0h1m-8 3h1"/></svg></dt>
                        <dd class="m-0">@Model.Showtime.Date.ToString("ddd, dd MMM yyyy", culture)</dd>
                    </div>
                    <div class="flex items-center gap-2">
                        <dt><span class="sr-only">Showtime</span><svg class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></dt>
                        <dd class="m-0">@Model.Showtime.Time.ToString("HH:mm", culture)</dd>
                    </div>
                </dl>

                @* Total and Seats run down the left; Admissions heads the right column with the QR code directly beneath it, beside Seats. *@
                <div class="mt-8 grid min-w-0 grid-cols-[minmax(0,1fr)_auto] gap-x-5 gap-y-6">
                    <dl class="contents">
                        <div class="min-w-0">
                            <dt class="@detailLabelClass">Total</dt>
                            <dd class="m-0 text-3xl font-black tracking-tight text-cinema-lemon">฿@booking.Total.ToString("N0", culture)</dd>
                        </div>
                        <div>
                            <dt class="@detailLabelClass">Admissions</dt>
                            <dd class="m-0 text-3xl font-black tracking-tight text-cinema-cream">@booking.TicketCount</dd>
                        </div>
                        <div class="min-w-0">
                            <dt class="@detailLabelClass">Seats</dt>
                            <dd class="m-0 break-words text-2xl font-bold text-cinema-lemon">@seats</dd>
                        </div>
                        <div class="min-w-0 col-start-1 row-start-3">
                            <dt class="@detailLabelClass">Demo reference</dt>
                            <dd class="m-0 break-all font-mono text-lg font-bold tracking-wider text-cinema-lemon">@booking.Reference</dd>
                        </div>
                    </dl>

                    @if (booking.TicketToken is { } ticketToken)
                    {
                        var ticketUrl = Qr.TicketUrl(Context.Request, ticketToken);
                        <div class="col-start-2 row-span-2 row-start-2 w-28 self-start sm:w-32">
                            <a class="block rounded-2xl bg-white p-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-cream" href="@ticketUrl">
                                @Html.Raw(Qr.Svg(ticketUrl, "block size-full", $"QR code for ticket {booking.Reference}"))
                            </a>
                            <p class="m-0 mt-2 text-center text-[11px] leading-snug text-cinema-cream/70">Show at the hall entrance</p>
                        </div>
                    }
                </div>

            </div>
        </div>
    </article>

    @* Icons: Heroicons 2.2.0 outline (MIT), ticket, film and arrow-right. *@
    <nav class="mx-auto mb-12 mt-8 flex w-full max-w-[480px] flex-col gap-4" aria-label="After booking">
        <a class="bk-stub-link group focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cinema-ink" href="/MyTickets/@booking.Reference/@Model.Movie.Slug">
            <span class="bk-stub-link__paper">
                <span class="bk-stub-link__end" aria-hidden="true">
                    <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 1 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 1 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z" /></svg>
                </span>
                <span class="flex min-w-0 flex-1 flex-col gap-1">
                    <span class="text-lg font-black leading-tight tracking-tight">View my ticket</span>
                    <span class="text-xs font-semibold leading-snug text-cinema-ink/55">Saved in My Tickets · <span class="whitespace-nowrap font-mono font-bold tracking-[0.14em]">@booking.Reference</span></span>
                </span>
                <svg class="bk-stub-link__arrow size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </span>
        </a>

        <div class="flex flex-wrap justify-center gap-3">
            <a class="@pillClass bg-cinema-deep hover:bg-cinema-ink" asp-action="Showtimes" asp-route-movie="@Model.Movie.Slug">
                <span class="inline-flex items-center gap-2 text-cinema-cream">
                    <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h1.5C5.496 19.5 6 18.996 6 18.375m-3.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-1.5A1.125 1.125 0 0 1 18 18.375M20.625 4.5H3.375m17.25 0c.621 0 1.125.504 1.125 1.125M20.625 4.5h-1.5C18.504 4.5 18 5.004 18 5.625m3.75 0v1.5c0 .621-.504 1.125-1.125 1.125M3.375 4.5c-.621 0-1.125.504-1.125 1.125M3.375 4.5h1.5C5.496 4.5 6 5.004 6 5.625m-3.75 0v1.5c0 .621.504 1.125 1.125 1.125m0 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m1.5-3.75C5.496 8.25 6 7.746 6 7.125v-1.5M4.875 8.25C5.496 8.25 6 8.754 6 9.375v1.5m0-5.25v5.25m0-5.25C6 5.004 6.504 4.5 7.125 4.5h9.75c.621 0 1.125.504 1.125 1.125m1.125 2.625h1.5m-1.5 0A1.125 1.125 0 0 1 18 7.125v-1.5m1.125 2.625c-.621 0-1.125.504-1.125 1.125v1.5m2.625-2.625c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125M18 5.625v5.25M7.125 12h9.75m-9.75 0A1.125 1.125 0 0 1 6 10.875M7.125 12C6.504 12 6 12.504 6 13.125m0-2.25C6 11.496 5.496 12 4.875 12M18 10.875c0 .621-.504 1.125-1.125 1.125M18 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m-12 5.25v-5.25m0 5.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125m-12 0v-1.5c0-.621-.504-1.125-1.125-1.125M18 18.375v-5.25m0 5.25v-1.5c0-.621.504-1.125 1.125-1.125M18 13.125v1.5c0 .621.504 1.125 1.125 1.125M18 13.125c0-.621.504-1.125 1.125-1.125M6 13.125v1.5c0 .621-.504 1.125-1.125 1.125M6 13.125C6 12.504 5.496 12 4.875 12m-1.5 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M19.125 12h1.5m0 0c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h1.5m14.25 0h1.5" /></svg>
                    Book another screening
                </span>
            </a>
            <a class="@pillClass border border-solid border-cinema-ink/25 hover:bg-cinema-ink/5" href="/">
                <span class="text-cinema-ink">Return to homepage</span>
            </a>
        </div>
    </nav>
</div>

@if (ViewData["Celebrate"] is true)
{
    <div class="bk-confetti" data-confetti="@Url.Content("~/animations/confetti.json")" aria-hidden="true"></div>
    <script src="~/lib/lottie/lottie_light.min.js" asp-append-version="true" defer></script>
    <script src="~/js/booking/confetti.js" asp-append-version="true" defer></script>
}
